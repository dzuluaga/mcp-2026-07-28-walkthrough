{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mcpa/api/:path*", "destination": "/api/:path*" }
  ],
  "redirects": [
    { "source": "/", "destination": "/mcpa/", "permanent": false },
    { "source": "/:path((?!mcpa(?:/|$)|api/).*)", "destination": "/mcpa/:path", "permanent": true }
  ]
}
